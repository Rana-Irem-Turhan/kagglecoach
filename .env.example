# KaggleCoach optional environment variables.
# Copy this file to `.env` (or set the variables in your shell) if you want
# to use Azure OpenAI as the chat backend via the sidebar toggle.
#
# The three variables below are ONLY read when the Azure toggle is enabled
# in the UI. They are not needed for the default Foundry Local mode.
#
# IMPORTANT: `.env` is in `.gitignore` — never commit real credentials.

# Your Azure OpenAI resource endpoint (with trailing slash optional):
#     https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# The API key from the Azure OpenAI resource:
AZURE_OPENAI_API_KEY=your-key-goes-here

# The deployment name for a chat model (e.g. gpt-4o-mini, gpt-4o):
AZURE_OPENAI_DEPLOYMENT=your-deployment-name


# ---------------------------------------------------------------------------
# Windows PowerShell reminders
# ---------------------------------------------------------------------------
#
# Per-session (lost when the shell closes):
#     $env:AZURE_OPENAI_ENDPOINT = "https://..."
#     $env:AZURE_OPENAI_API_KEY = "..."
#     $env:AZURE_OPENAI_DEPLOYMENT = "..."
#
# Persistent for the current user (requires restarting PowerShell):
#     [System.Environment]::SetEnvironmentVariable("AZURE_OPENAI_ENDPOINT", "https://...", "User")
#     [System.Environment]::SetEnvironmentVariable("AZURE_OPENAI_API_KEY", "...", "User")
#     [System.Environment]::SetEnvironmentVariable("AZURE_OPENAI_DEPLOYMENT", "...", "User")
#
# Legacy `setx` also works but truncates values longer than 1024 characters
# and only takes effect in NEW shells:
#     setx AZURE_OPENAI_ENDPOINT "https://..."
